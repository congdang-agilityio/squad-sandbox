# Copy to .env.local. Each developer slot uses its own test database app_test_<slot>.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/app_test_1

# Email. SMTP_URL set: send through SMTP, e.g. smtp://user:pass@smtp.example.com:587.
# Otherwise MAIL_OUTBOX_DIR set: write each message as a JSON file there (local, tests, e2e).
# Neither set: sending an email fails.
SMTP_URL=
MAIL_FROM="TodoNow <no-reply@example.com>"
MAIL_OUTBOX_DIR=/tmp/todonow-outbox
# Public base URL used in links inside emails (e.g. the password reset link).
APP_BASE_URL=http://localhost:3000
