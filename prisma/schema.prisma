generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person with an account. `email` is stored lowercased (CHECK constraint in the migration).
model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String
  displayName           String
  /// When the user agreed to the privacy notice (BR-19); set by the sign-up service.
  privacyNoticeAgreedAt DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  tasks                 Task[]
}

/// A login on one device. Only a hash of the session token is stored. There is no expiry:
/// a login lasts until logout or account deletion (A-19).
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?

  @@index([userId])
}

/// A single-use, expiring password reset request. Only a SHA-256 hash of the token is stored,
/// never the raw token. `usedAt` is set once the token has been redeemed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum TaskPriority {
  HIGH
  NORMAL
  LOW
}

/// A to-do item owned by its creator (BR-02: title and due date required, time optional;
/// BR-03: priority defaults to Normal). CHECK constraints in the migration reject a blank
/// `title` and a `dueTime` that is not `HH:MM` 24-hour.
model Task {
  id        String       @id @default(cuid())
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime     @db.Date
  dueTime   String?
  priority  TaskPriority @default(NORMAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
}
